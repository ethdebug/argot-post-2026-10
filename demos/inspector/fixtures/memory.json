{"program":{"name":"Arcade","file":"bug/arcade.bug","source":"name Arcade;\n\ndefine {\n  struct Player {\n    score: uint64;\n    combo: uint32;\n    bestCombo: uint32;\n    plays: uint32;\n    hits: uint32;\n    lastBlock: uint64;   // when they last played\n    name: string;        // the next slot\n  };\n\n  // a toy roll (not safe randomness): 2 in 3 is a hit. Equal to\n  // Solidity's keccak256(abi.encode(block.prevrandao, msg.sender))\n  function _rolledHit() -> bool {\n    return (keccak256(block.prevrandao, msg.sender) as uint256) % 3 != 0;\n  };\n\n  function _applyCombo(points: uint64, combo: uint32) -> uint64 {\n    let mult: uint64 = 5;   // the multiplier stops at 5\n    if (combo < 5) {\n      mult = combo;\n    }\n    return points * mult;\n  };\n}\n\nstorage {\n  [0] playerList: array<address>;  // who joined, in order (a mapping can't list its keys)\n  [1] motd: string;                // the message of the day\n  [2] totalScore: uint128;         // every player's points\n  [3] totalHits: uint64;           // every player's hits\n  [4] players: mapping<address, Player>;\n}\n\ncreate {\n  motd = \"season 2 starts friday, see you on the leaderboard\";\n}\n\ncode {\n  // setMotd(string): anyone may\n  if (msg.data[0:4] as bytes4 == 0x5fe59b9d) {\n    let len = msg.data[36:68] as bytes32 as uint256;\n    motd = msg.data[68:68 + len] as string;\n    return;\n  }\n  // join(string): pick a name, once (BUG has no revert, so no checks)\n  if (msg.data[0:4] as bytes4 == 0x6a786b07) {\n    let len = msg.data[36:68] as bytes32 as uint256;\n    players[msg.sender].name = msg.data[68:68 + len] as string;\n    playerList.push(msg.sender);\n    return;\n  }\n  // play()\n  players[msg.sender].plays = players[msg.sender].plays + 1;\n  players[msg.sender].lastBlock = block.number as uint64;\n  let hit = _rolledHit();\n  if (!hit) {\n    players[msg.sender].combo = 0;   // _resetCombo, inlined by hand\n    return;\n  }\n  players[msg.sender].combo = players[msg.sender].combo + 1;\n  players[msg.sender].hits = players[msg.sender].hits + 1;\n  if (players[msg.sender].combo > players[msg.sender].bestCombo) {\n    players[msg.sender].bestCombo = players[msg.sender].combo;\n  }\n  let gained = _applyCombo(10, players[msg.sender].combo);\n  players[msg.sender].score = players[msg.sender].score + gained;\n  totalScore = totalScore + gained;\n  totalHits = totalHits + 1;\n}\n"},"compiler":{"name":"bugc","branch":"main","commit":"d7cb421a36a3b4cef1a9d954da8316cf6e43424e"},"player":"0x70997970c51812dc3a010c7d01b50e0d17dc79c8","levels":[{"optimize":0,"tx":{"hash":"0x5c7e743281cacaf8daffc3ae4299968f7336ba472762320e7f703abd29f22e06","to":"0x5fbdb2315678afecb367f032d93f642f64180aa3","block":22},"trace":{"steps":962},"points":[{"id":"roll","title":"After the roll","steps":[{"step":399,"pc":1621,"op":"DUP1","depth":1,"range":{"offset":1734,"length":4},"variables":[{"identifier":"hit","type":{"kind":"bool"},"declaration":{"source":{"id":"bug/arcade.bug"},"range":{"offset":1708,"length":18}},"pointer":{"name":"hit","location":"memory","offset":223,"length":1}}],"memory":""}]},{"id":"mult","title":"Inside _applyCombo","steps":[{"step":791,"pc":2513,"op":"JUMPDEST","depth":1,"variables":[{"identifier":"points","type":{"kind":"uint","bits":64},"declaration":{"source":{"id":"bug/arcade.bug"},"range":{"offset":507,"length":14}},"pointer":{"group":[{"name":"-frame","location":"memory","offset":128,"length":32},{"name":"points","location":"memory","offset":{"~sum":[{"~read":"-frame"},120]},"length":8}]}},{"identifier":"combo","type":{"kind":"uint","bits":32},"declaration":{"source":{"id":"bug/arcade.bug"},"range":{"offset":523,"length":13}},"pointer":{"group":[{"name":"-frame","location":"memory","offset":128,"length":32},{"name":"combo","location":"memory","offset":{"~sum":[{"~read":"-frame"},188]},"length":4}]}},{"identifier":"mult","type":{"kind":"uint","bits":64},"declaration":{"source":{"id":"bug/arcade.bug"},"range":{"offset":558,"length":16}},"p