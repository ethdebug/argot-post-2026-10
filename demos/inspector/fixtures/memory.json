{"program":{"name":"Arcade","file":"bug/arcade.bug","source":"name Arcade;\n\ndefine {\n  struct Player {\n    score: uint64;\n    combo: uint32;\n    bestCombo: uint32;\n    plays: uint32;\n    hitCount: uint32;\n    lastBlock: uint64;   // when they last played\n    name: string;        // the next slot\n  };\n\n  // a toy roll (not safe randomness): 2 in 3 is a hit. Equal to\n  // Solidity's keccak256(abi.encode(block.prevrandao, msg.sender))\n  function rolledHit() -> bool {\n    return (keccak256(block.prevrandao, msg.sender) as uint256) % 3 != 0;\n  };\n\n  function multiplied(points: uint64, combo: uint32) -> uint64 {\n    let m: uint64 = 5;\n    if (combo < 5) {\n      m = combo;\n    }\n    return points * m;\n  };\n}\n\nstorage {\n  [0] roster: array<address>;  // everyone who has joined (a mapping can't list its keys)\n  [1] motd: string;            // the server's message of the day\n  [2] total: uint128;          // all players' points\n  [3] rounds: uint64;          // the number of hits\n  [4] players: mapping<address, Player>;\n}\n\ncreate {\n  motd = \"season 2 starts friday, see you on the leaderboard\";\n}\n\ncode {\n  // setMotd(string)\n  if (msg.data[0:4] as bytes4 == 0x5fe59b9d) {\n    let len = msg.data[36:68] as bytes32 as uint256;\n    motd = msg.data[68:68 + len] as string;\n    return;\n  }\n  // join(string): pick a name, once (BUG has no revert, so no checks)\n  if (msg.data[0:4] as bytes4 == 0x6a786b07) {\n    let len = msg.data[36:68] as bytes32 as uint256;\n    players[msg.sender].name = msg.data[68:68 + len] as string;\n    roster.push(msg.sender);\n    return;\n  }\n  // play()\n  players[msg.sender].plays = players[msg.sender].plays + 1;\n  players[msg.sender].lastBlock = block.number as uint64;\n  let hit = rolledHit();\n  if (!hit) {\n    players[msg.sender].combo = 0;   // resetCombo, inlined by hand\n    return;\n  }\n  players[msg.sender].combo = players[msg.sender].combo + 1;\n  players[msg.sender].hitCount = players[msg.sender].hitCount + 1;\n  if (players[msg.sender].combo > players[msg.sender].bestCombo) {\n    players[msg.sender].bestCombo = players[msg.sender].combo;\n  }\n  let gained = multiplied(10, players[msg.sender].combo);\n  players[msg.sender].score = players[msg.sender].score + gained;\n  total = total + gained;\n  rounds = rounds + 1;\n}\n"},"compiler":{"name":"bugc","branch":"main","commit":"1d45fea4c49b849c10399f55436843f33fdad4f0"},"player":"0x70997970c51812dc3a010c7d01b50e0d17dc79c8","levels":[{"optimize":0,"tx":{"hash":"0xfc500d352ed901643404a9694439ef0041d744503f573cf3d857375e2c1494c9","to":"0x5fbdb2315678afecb367f032d93f642f64180aa3","block":12},"trace":{"steps":1002},"points":[{"id":"roll","title":"After the roll","steps":[{"step":439,"pc":1421,"op":"DUP1","depth":1,"range":{"offset":1672,"length":4},"variables":[{"identifier":"hit","type":{"kind":"bool"},"declaration":{"source":{"id":"bug/arcade.bug"},"range":{"offset":1647,"length":17}},"pointer":{"name":"hit","location":"memory","offset":223,"length":1}}],"memory":""}]},{"id":"mult","title":"Inside multiplied","steps":[{"step":831,"pc":2313,"op":"JUMPDEST","depth":1,"variables":[{"identifier":"points","type":{"kind":"uint","bits":64},"declaration":{"source":{"id":"bug/arcade.bug"},"range":{"offset":509,"length":14}},"pointer":{"group":[{"name":"-frame","location":"memory","offset":128,"length":32},{"name":"points","location":"memory","offset":{"$sum":[{"$read":"-frame"},120]},"length":8}]}},{"identifier":"combo","type":{"kind":"uint","bits":32},"declaration":{"source":{"id":"bug/arcade.bug"},"range":{"offset":525,"length":13}},"pointer":{"group":[{"name":"-frame","location":"memory","offset":128,"length":32},{"name":"combo","location":"memory","offset":{"$sum":[{"$read":"-frame"},188]},"length":4}]}},{"identifier":"m","type":{"kind":"uint","bits":64},"declaration":{"source":{"id":"bug/arcade.bug"},"range":{"offset":560,"length":13}},"pointer":{"group":[{"name":"-frame","location":"memory","offset":128,"length