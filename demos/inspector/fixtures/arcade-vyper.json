{"id":"arcade-vyper","summary":"Vyper: the middle of the game","tx":{"hash":"0xdcde491ed0fdfce85bbbc6f9a70c53eb76afa27f5714578b92487031b7847796","from":"0x90f79bf6eb2c4f870365e785982e1f101e93b906","to":"0x9fe46736679d2d9a65f0992f2272de9f3c7fa6e0","input":"0x93e84cd9","block":47},"contract":{"name":"Arcade","file":"Arcade.sol","source":"// SPDX-License-Identifier: MIT\npragma solidity ^0.8.0;\n\ncontract Arcade {\n    struct Player {\n        uint64 score;       // ┐\n        uint32 combo;       // │\n        uint32 bestCombo;   // │ one full slot: 8+4+4+4+4+8 = 32 bytes\n        uint32 plays;       // │\n        uint32 hits;        // │\n        uint64 lastBlock;   // ┘ when they last played\n        string name;        //   the next slot\n    }\n    address[] public playerList;  // who joined, in order (a mapping can't list its keys)\n    string public motd;           // the message of the day\n    uint128 public totalScore;    // ┐ one slot: every player's points\n    uint64 public totalHits;      // ┘   and every player's hits\n    mapping(address => Player) public players;\n    constructor(string memory initialMotd) { motd = initialMotd; }\n    function join(string calldata name) external {   // pick a name, once\n        require(bytes(name).length > 0 && bytes(players[msg.sender].name).length == 0);\n        players[msg.sender].name = name;\n        playerList.push(msg.sender);\n    }\n    function play() external {\n        Player storage player = players[msg.sender];\n        require(bytes(player.name).length > 0);   // joined\n        player.plays += 1;\n        player.lastBlock = uint64(block.number);\n        if (!_rolledHit()) { _resetCombo(player); return; }   // a miss\n        player.combo += 1;\n        player.hits += 1;\n        if (player.combo > player.bestCombo) player.bestCombo = player.combo;\n        uint64 gained = _applyCombo(10, player.combo);\n        player.score += gained; totalScore += gained; totalHits += 1;\n    }\n    function setMotd(string calldata text) external { motd = text; }   // anyone may\n    // a toy roll (not safe randomness): 2 in 3 is a hit\n    function _rolledHit() internal view returns (bool) {\n        return uint256(keccak256(abi.encode(block.prevrandao, msg.sender))) % 3 != 0;\n    }\n    function _resetCombo(Player storage player) internal { player.combo = 0; }\n    function _applyCombo(uint64 points, uint32 combo) internal pure returns (uint64) {\n        return points * (combo < 5 ? combo : 5);   // the multiplier stops at 5\n    }\n}\n","compiler":"0.8.38-develop.2026.10.5+commit.c434b2ea.Darwin.appleclang","variables":[{"declaration":{"range":{"length":41,"offset":712},"source":{"id":0}},"identifier":"players","pointer":{"location":"storage","slot":"0x03"},"type":{"id":"t_mapping$_t_address_$_t_struct$_Player_$16_storage_$"}}],"types":{"t_address":{"kind":"address","payable":false},"t_array$_t_address_$dyn_storage":{"contains":{"type":{"id":"t_address"}},"kind":"array"},"t_bool":{"kind":"bool"},"t_mapping$_t_address_$_t_struct$_Player_$16_storage_$":{"contains":{"key":{"type":{"id":"t_address"}},"value":{"type":{"id":"t_struct$_Player_$16_storage"}}},"kind":"mapping"},"t_string_storage":{"kind":"string"},"t_struct$_Player_$16_storage":{"contains":[{"name":"score","type":{"id":"t_uint64"}},{"name":"combo","type":{"id":"t_uint32"}},{"name":"bestCombo","type":{"id":"t_uint32"}},{"name":"plays","type":{"id":"t_uint32"}},{"name":"hits","type":{"id":"t_uint32"}},{"name":"lastBlock","type":{"id":"t_uint64"}},{"name":"name","type":{"id":"t_string_storage"}}],"definition":{"location":{"range":{"length":338,"offset":79},"source":{"id":0}},"name":"Player"},"kind":"struct"},"t_uint128":{"bits":128,"kind":"uint"},"t_uint32":{"bits":32,"kind":"uint"},"t_uint64":{"bits":64,"kind":"uint"}},"pointers":{"t_array$_t_address_$dyn_storage":{"expect":["slot"],"for":{"group":[{"location":"storage","name":"length","slot":"slot"},{"define":{"data":{"$keccak256":[{"$wordsized":"slot"}]}},"in":{"l