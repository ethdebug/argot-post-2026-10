{"id":"strings-update","title":"Strings: one grows long, one shrinks short","summary":"update(\"a string longer than thirty-one bytes, stored long\", \"now short\")","tx":{"hash":"0x0d7d8a1ac85ba1ca772ff6d3d6ee8b5bba17da171e7a156fbf653e48e82f3ad5","from":"0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266","to":"0x9d4454b023096f34b160d6b654540c56a1f81688","input":"","block":48},"contract":{"name":"Strings","file":"Strings.sol","source":"// SPDX-License-Identifier: MIT\npragma solidity ^0.8.0;\n\ncontract Strings {\n    string public grows;   // short, then long\n    string public shrinks; // long, then short\n    string public most;    // 31 bytes: the longest short string\n    string public least;   // 32 bytes: the shortest long string\n\n    function setAll(\n        string calldata g,\n        string calldata s,\n        string calldata m,\n        string calldata l\n    ) external {\n        grows = g;\n        shrinks = s;\n        most = m;\n        least = l;\n    }\n\n    function update(string calldata g, string calldata s) external {\n        grows = g;\n        shrinks = s;\n    }\n}\n","compiler":"0.8.38-ci.2026.10.1+commit.b3b7db6a.Emscripten.clang","layout":{"storage":[{"astId":3,"contract":"Strings.sol:Strings","label":"grows","offset":0,"slot":"0","type":"t_string_storage"},{"astId":5,"contract":"Strings.sol:Strings","label":"shrinks","offset":0,"slot":"1","type":"t_string_storage"},{"astId":7,"contract":"Strings.sol:Strings","label":"most","offset":0,"slot":"2","type":"t_string_storage"},{"astId":9,"contract":"Strings.sol:Strings","label":"least","offset":0,"slot":"3","type":"t_string_storage"}],"types":{"t_string_storage":{"encoding":"bytes","label":"string","numberOfBytes":"32"}}},"types":{"t_string_storage":{"kind":"string"}},"pointers":{"t_string_storage":{"expect":["slot"],"for":{"group":[{"length":"0x01","location":"storage","name":"length-flag","offset":{"$difference":["$wordsize","0x01"]},"slot":"slot"},{"else":{"group":[{"location":"storage","name