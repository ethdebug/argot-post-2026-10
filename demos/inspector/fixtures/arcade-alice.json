{"id":"arcade-alice","summary":"alice's third hit","tx":{"hash":"0xb25cbbf7ffd6358a1c27bdfb8086dd26105d9bb907904fb3ffb3e55cf3d9ebce","from":"0x70997970c51812dc3a010c7d01b50e0d17dc79c8","to":"0x5fbdb2315678afecb367f032d93f642f64180aa3","input":"0x93e84cd9","block":12},"contract":{"name":"Arcade","file":"Arcade.sol","source":"// SPDX-License-Identifier: MIT\npragma solidity ^0.8.0;\n\ncontract Arcade {\n    struct Player {\n        uint64 score;       // ┐\n        uint32 combo;       // │\n        uint32 bestCombo;   // │ one full slot: 8+4+4+4+4+8 = 32 bytes\n        uint32 plays;       // │\n        uint32 hitCount;    // │\n        uint64 lastBlock;   // ┘ when they last played\n        string name;        //   the next slot\n    }\n    mapping(address => Player) public players;\n    address[] public roster;   // everyone who has joined (a mapping can't list its keys)\n    string public motd;        // the server's message of the day\n    uint128 public total;      // all players' points, packed with\n    uint64 public rounds;      //   the number of hits\n    constructor(string memory m) { motd = m; }\n    function join(string calldata name) external {   // pick a name, once\n        require(bytes(name).length > 0 && bytes(players[msg.sender].name).length == 0);\n        players[msg.sender].name = name;\n        roster.push(msg.sender);\n    }\n    function play() external {\n        Player storage p = players[msg.sender];\n        require(bytes(p.name).length > 0);   // joined\n        p.plays += 1;\n        p.lastBlock = uint64(block.number);\n        if (!rolledHit()) { resetCombo(p); return; }   // a miss\n        p.combo += 1;\n        p.hitCount += 1;\n        if (p.combo > p.bestCombo) p.bestCombo = p.combo;\n        uint64 gained = multiplied(10, p.combo);\n        p.score += gained; total += gained; rounds += 1;\n    }\n    function setMotd(string calldata text) external { motd = text; }\n    // a toy roll (not safe randomness): 2 in 3 is a hit\n    function rolledHit() internal view returns (bool) {\n        return uint256(keccak256(abi.encode(block.prevrandao, msg.sender))) % 3 != 0;\n    }\n    function resetCombo(Player storage p) internal { p.combo = 0; }\n    function multiplied(uint64 points, uint32 combo) internal pure returns (uint64) {\n        return points * (combo < 5 ? combo : 5);\n    }\n}\n","compiler":"0.8.38-develop.2026.10.5+commit.c434b2ea.Darwin.appleclang","variables":[{"declaration":{"range":{"length":41,"offset":422},"source":{"id":0}},"identifier":"players","pointer":{"location":"storage","slot":"0x00"},"type":{"id":"t_mapping$_t_address_$_t_struct$_Player_$16_storage_$"}},{"declaration":{"range":{"length":23,"offset":469},"source":{"id":0}},"identifier":"roster","pointer":{"define":{"slot":"0x01"},"in":{"template":"t_array$_t_address_$dyn_storage"}},"type":{"id":"t_array$_t_address_$dyn_storage"}},{"declaration":{"range":{"length":18,"offset":559},"source":{"id":0}},"identifier":"motd","pointer":{"define":{"slot":"0x02"},"in":{"template":"t_string_storage"}},"type":{"id":"t_string_storage"}},{"declaration":{"range":{"length":20,"offset":625},"source":{"id":0}},"identifier":"total","pointer":{"length":"0x10","location":"storage","offset":"0x10","slot":"0x03"},"type":{"id":"t_uint128"}},{"declaration":{"range":{"length":20,"offset":692},"source":{"id":0}},"identifier":"rounds","pointer":{"length":"0x08","location":"storage","offset":"0x08","slot":"0x03"},"type":{"id":"t_uint64"}}],"types":{"t_address":{"kind":"address","payable":false},"t_array$_t_address_$dyn_storage":{"contains":{"type":{"id":"t_address"}},"kind":"array"},"t_bool":{"kind":"bool"},"t_mapping$_t_address_$_t_struct$_Player_$16_storage_$":{"contains":{"key":{"type":{"id":"t_address"}},"value":{"type":{"id":"t_struct$_Player_$16_storage"}}},"kind":"mapping"},"t_string_storage":{"kind":"string"},"t_struct$_Player_$16_storage":{"contains":[{"name":"score","type":{"id":"t_uint64"}},{"name":"combo","type":{"id":"t_uint32"}},{"name"