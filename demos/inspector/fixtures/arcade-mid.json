{"id":"arcade-mid","summary":"the middle of the game","tx":{"hash":"0x952ff0a078ddb715007f68bd2c221f2f1324e292ab33a36523a32bf914d7ef65","from":"0x90f79bf6eb2c4f870365e785982e1f101e93b906","to":"0x5fbdb2315678afecb367f032d93f642f64180aa3","input":"0x93e84cd9","block":21},"contract":{"name":"Arcade","file":"Arcade.sol","source":"// SPDX-License-Identifier: MIT\npragma solidity ^0.8.0;\n\ncontract Arcade {\n    struct Player {\n        uint64 score;       // ┐\n        uint32 combo;       // │\n        uint32 bestCombo;   // │ one full slot: 8+4+4+4+4+8 = 32 bytes\n        uint32 plays;       // │\n        uint32 hits;        // │\n        uint64 lastBlock;   // ┘ when they last played\n        string name;        //   the next slot\n    }\n    address[] public playerList;  // who joined, in order (a mapping can't list its keys)\n    string public motd;           // the message of the day\n    uint128 public totalScore;    // ┐ one slot: every player's points\n    uint64 public totalHits;      // ┘   and every player's hits\n    mapping(address => Player) public players;\n    constructor(string memory initialMotd) { motd = initialMotd; }\n    function join(string calldata name) external {   // pick a name, once\n        require(bytes(name).length > 0 && bytes(players[msg.sender].name).length == 0);\n        players[msg.sender].name = name;\n        playerList.push(msg.sender);\n    }\n    function play() external {\n        Player storage player = players[msg.sender];\n        require(bytes(player.name).length > 0);   // joined\n        player.plays += 1;\n        player.lastBlock = uint64(block.number);\n        if (!_rolledHit()) { _resetCombo(player); return; }   // a miss\n        player.combo += 1;\n        player.hits += 1;\n        if (player.combo > player.bestCombo) player.bestCombo = player.combo;\n        uint64 gained = _applyCombo(10, player.combo);\n        player.score += gained; totalScore += gained; totalHits += 1;\n    }\n    function setMotd(string calldata text) external { motd = text; }   // anyone may\n    // a toy roll (not safe randomness): 2 in 3 is a hit\n    function _rolledHit() internal view returns (bool) {\n        return uint256(keccak256(abi.encode(block.prevrandao, msg.sender))) % 3 != 0;\n    }\n    function _resetCombo(Player storage player) internal { player.combo = 0; }\n    function _applyCombo(uint64 points, uint32 combo) internal pure returns (uint64) {\n        return points * (combo < 5 ? combo : 5);   // the multiplier stops at 5\n    }\n}\n","compiler":"0.8.38-develop.2026.10.5+commit.c434b2ea.Darwin.appleclang","variables":[{"declaration":{"range":{"length":27,"offset":422},"source":{"id":0}},"identifier":"playerList","pointer":{"define":{"slot":"0x00"},"in":{"template":"t_array$_t_address_$dyn_storage"}},"type":{"id":"t_array$_t_address_$dyn_storage"}},{"declaration":{"range":{"length":18,"offset":512},"source":{"id":0}},"identifier":"motd","pointer":{"define":{"slot":"0x01"},"in":{"template":"t_string_storage"}},"type":{"id":"t_string_storage"}},{"declaration":{"range":{"length":25,"offset":572},"source":{"id":0}},"identifier":"totalScore","pointer":{"length":"0x10","location":"storage","offset":"0x10","slot":"0x02"},"type":{"id":"t_uint128"}},{"declaration":{"range":{"length":23,"offset":645},"source":{"id":0}},"identifier":"totalHits","pointer":{"length":"0x08","location":"storage","offset":"0x08","slot":"0x02"},"type":{"id":"t_uint64"}},{"declaration":{"range":{"length":41,"offset":712},"source":{"id":0}},"identifier":"players","pointer":{"location":"storage","slot":"0x03"},"type":{"id":"t_mapping$_t_address_$_t_struct$_Player_$16_storage_$"}}],"types":{"t_address":{"kind":"address","payable":false},"t_array$_t_address_$dyn_storage":{"contains":{"type":{"id":"t_address"}},"kind":"array"},"t_bool":{"kind":"bool"},"t_mapping$_t_address_$_t_struct$_Player_$16_storage_$":{"contains":{"key":{"type":{"id":"t_address"}},"value":{"type":{"id":"t_struct$_Player_$16_storage"}}},"kind":"map