name Weights;

define {
  function dbl(x: uint256) -> uint256 {
    return x + x;
  };

  function tri(k: uint256) -> uint256 {
    if (k == 0) {
      return 0;
    }
    return k + tri(k - 1);
  };

  function weight(i: uint256, n: uint256) -> uint256 {
    let w = dbl(i) + n;
    if (i < 2) {
      return w;
    }
    return w + tri(i);
  };
}

storage {
  [0] total: uint256;
  [1] calls: uint256;
}

code {
  let n = 4;
  let sum = 0;
  for (let i = 0; i < n; i = i + 1) {
    sum = sum + weight(i, n);
  }
  total = total + sum;
  calls = calls + 1;
}
