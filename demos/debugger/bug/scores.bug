// Scores.sol in BUG. A BUG contract has one entry point, its code
// block, so this is record alone (no setMotto, and so no motto). BUG has
// no push, so record writes history[rounds]. bugc stores no length for
// a dynamic array in storage, so history's length stays 0.
name Scores;

define {
  struct Player {
    score: uint64;
    streak: uint32;
    active: bool;
  };

  function bonus(points: uint256, streak: uint256) -> uint256 {
    let b = points * streak;
    if (b > 100) {
      b = 100;
    }
    return b;
  };
}

storage {
  [0] players: mapping<address, Player>;
  [1] history: array<uint256>;
  [2] total: uint128;
  [3] rounds: uint64;
}

code {
  let points: uint256 = msg.data[4:36] as bytes32 as uint256;
  let streak: uint256 = players[msg.sender].streak;
  let gained = points + bonus(points, streak);
  players[msg.sender].score = players[msg.sender].score + gained;
  players[msg.sender].streak = players[msg.sender].streak + 1;
  players[msg.sender].active = true;
  history[rounds] = gained;
  total = total + gained;
  rounds = rounds + 1;
}
