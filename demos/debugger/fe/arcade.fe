use std::abi::sol
use core::abi::DynString
use std::evm::{Ctx, StorageBytes, StorageMap, keccak_words}

msg ArcadeMsg {
    #[selector = sol("join(string)")]
    Join { name: DynString },
    #[selector = sol("play()")]
    Play,
    #[selector = sol("setMotd(string)")]
    SetMotd { text: DynString },
}

// Fe's StorageMap values must fit in one word: one map per Player field.
struct ArcadeStore {
    player_list: StorageMap<u256, Address, 0>,   // who joined, in order (a mapping can't list its keys)
    player_count: u256,                          //   (no dynamic array: a map by index + a length)
    total_score: u128,                           // ┐ every player's points
    total_hits: u64,                             // ┘   and every player's hits
    scores: StorageMap<Address, u64, 3>,
    combos: StorageMap<Address, u32, 4>,
    best_combos: StorageMap<Address, u32, 5>,
    plays: StorageMap<Address, u32, 6>,
    hits: StorageMap<Address, u32, 7>,
    last_blocks: StorageMap<Address, u64, 8>,   // when they last played
}

type Motd = StorageBytes<u256, 1, 2>       // the message of the day
type Names = StorageBytes<Address, 9, 10>  // each player's name

// a toy roll (not safe randomness): 2 in 3 is a hit
fn rolled_hit() -> bool uses (ctx: Ctx) {
    return keccak_words([ctx.prevrandao(), ctx.caller().inner]) % 3 != 0
}

fn reset_combo(who: Address) uses (store: mut ArcadeStore) {
    store.combos.set(key: who, value: 0)
}

fn apply_combo(points: u64, combo: u32) -> u64 {   // the multiplier stops at 5
    if combo < 5 {
        return points * (combo as u64)
    }
    return points * 5
}

pub contract Arcade uses (ctx: Ctx) {
    mut store: ArcadeStore
    mut motd: Motd
    mut names: Names

    init(initial_motd: DynString) uses (mut motd) {
        motd.store_view(key: 0, view: initial_motd.as_bytes().view())
    }

    recv ArcadeMsg {
        Join { name } uses (mut store, mut names, ctx) {   // pick a name, once
            let me: Address = ctx.caller()
            assert(name.len() > 0 && names.len(key: me) == 0)
            names.store_view(key: me, view: name.as_bytes().view())
            store.player_list.set(key: store.player_count, value: me)
            store.player_count = store.player_count + 1
        }
        Play uses (mut store, names, ctx) {
            let me: Address = ctx.caller()
            assert(names.len(key: me) > 0)   // joined
            store.plays.set(key: me, value: store.plays.get(key: me) + 1)
            store.last_blocks.set(key: me, value: ctx.block_number().downcast_truncate())
            if !rolled_hit() {   // a miss
                reset_combo(who: me)
                return
            }
            store.combos.set(key: me, value: store.combos.get(key: me) + 1)
            store.hits.set(key: me, value: store.hits.get(key: me) + 1)
            if store.combos.get(key: me) > store.best_combos.get(key: me) {
                store.best_combos.set(key: me, value: store.combos.get(key: me))
            }
            let gained: u64 = apply_combo(points: 10, combo: store.combos.get(key: me))
            store.scores.set(key: me, value: store.scores.get(key: me) + gained)
            store.total_score = store.total_score + gained as u128
            store.total_hits = store.total_hits + 1
        }
        SetMotd { text } uses (mut motd) {   // anyone may
            motd.store_view(key: 0, view: text.as_bytes().view())
        }
    }
}
