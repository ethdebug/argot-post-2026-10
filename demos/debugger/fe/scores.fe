use std::abi::sol
use std::evm::{Ctx, StorageMap}

msg ScoresMsg {
    #[selector = sol("record(uint256)")]
    Record { points: u256 },
}

struct ScoresStore {
    scores: StorageMap<Address, u64, 0>,
    streaks: StorageMap<Address, u32, 1>,
    total: u128,
    rounds: u64,
}

fn bonus(points: u256, streak: u256) -> u256 {
    let mut b: u256 = points * streak
    if b > 100 {
        b = 100
    }
    return b
}

pub contract Scores uses (ctx: Ctx) {
    mut store: ScoresStore

    recv ScoresMsg {
        Record { points } uses (mut store, ctx) {
            let streak: u256 = store.streaks.get(key: ctx.caller()) as u256
            let gained: u256 = points + bonus(points: points, streak: streak)
            let score: u64 = store.scores.get(key: ctx.caller())
            store.scores.set(key: ctx.caller(), value: score + gained.downcast_truncate())
            store.streaks.set(key: ctx.caller(), value: store.streaks.get(key: ctx.caller()) + 1)
            store.total = store.total + gained.downcast_truncate()
            store.rounds = store.rounds + 1
        }
    }
}
